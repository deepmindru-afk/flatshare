#!/usr/bin/env bash
# in-voicenet CMD...: run CMD inside the voice-plane network namespace held by lh-voicenet.service.
# Inside there is loopback and a dummy interface, with no route out; the tunnels and the control plane are reached
# through Unix sockets in $XDG_RUNTIME_DIR/lh/.
# A holder that keeps no namespace (LH_VOICENET=host, see voicenet-holder) writes "host": CMD then runs as it is.
set -euo pipefail
pid=$(cat "${XDG_RUNTIME_DIR:?}/lh/voicenet.pid")
[[ $pid != host ]] || exec "$@"
exec nsenter --target "$pid" --user --net --preserve-credentials -- "$@"
