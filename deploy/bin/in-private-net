#!/usr/bin/env bash
# in-private-net CMD...: run CMD in a network namespace of its own, with a loopback interface and nothing else, as
# the GPU node's units run their servers (lh-engine, lh-stt and lh-tts). vLLM's engine cores listen on the loopback for
# torch's gloo groups, and CUDA keeps abstract sockets (@cuda-uvmfd-*): in the host's namespace every user of the host
# reaches both, in a namespace of its own nobody else does. The servers' own sockets are files in
# $XDG_RUNTIME_DIR/lh, which a network namespace does not hide, so the tunnel and the gateway reach them as before.
#
# The namespace is made in an unprivileged user namespace in which this user is root (unshare --map-root-user, as
# voicenet-holder makes the voice plane's), and ends with CMD; CMD keeps this process, so it stays the unit's main
# process. systemd's PrivateNetwork= cannot do it in a user manager: systemd 249 gives each process of a unit a user
# namespace of its own, and a process cannot join a network namespace that another's made, so the unit's processes
# land in namespaces of their own or the host's by turns.
#
# Where the kernel refuses unprivileged user namespaces (Ubuntu 24.04 restricts them), CMD runs in the host's
# namespace, marked LH_PRIVATE_NET=host in its environment, by which deploy/bin/audit-listeners counts its loopback
# listeners and abstract sockets apart; the single host's preflight reports it.
set -euo pipefail
if unshare --user --map-root-user --net -- sh -c 'ip link set lo up' 2>/dev/null; then
  exec unshare --user --map-root-user --net -- sh -c 'ip link set lo up && exec "$@"' sh "$@"
fi
echo "in-private-net: no network namespace of its own here (the kernel refuses unprivileged user namespaces):" \
  "$1 runs in the host's" >&2
export LH_PRIVATE_NET=host
exec "$@"
